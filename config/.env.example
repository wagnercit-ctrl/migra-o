# Copie para config/.env e preencha. Todos os campos abaixo sao lidos pelo codigo.

# Nome que aparece no topo do painel
CLINICA_NOME=Carla Nunes Estetica Negra

# Token de System User (permanente) - ver docs/COMO_LIBERAR_ACESSO_META.md
META_ACCESS_TOKEN=

# Conta de anuncio (act_ + numero). Gerenciador de Anuncios > numero da conta
META_AD_ACCOUNT=act_

# Pagina do Facebook da clinica (id numerico)
META_PAGE_ID=

# Conta profissional do Instagram. Pode deixar vazio: e descoberta pela pagina
META_IG_USER_ID=

# Metas que o painel usa para os alertas (opcionais)
META_CPL_ALVO=12
META_ORCAMENTO_MENSAL=4500
